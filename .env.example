# SquadWriter — frontend environment variables
#
# Copy this file to .env.local and fill in your Supabase project values.
# Vite ONLY exposes variables prefixed with VITE_ to the browser.
# NEVER commit .env.local — it is gitignored.

# Supabase project URL, e.g. https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for client use; all access is gated by RLS)
VITE_SUPABASE_ANON_KEY=
